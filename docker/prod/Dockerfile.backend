# リポジトリルートをコンテキストにしてビルドする:
#   docker build -f docker/prod/Dockerfile.backend -t janken-backend .
#
# Lightsail 上で実行。フロントは S3 + CloudFront に別デプロイ。

FROM --platform=linux/amd64 composer:2 AS composer-bin

FROM --platform=linux/amd64 php:8.3-fpm-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    nginx supervisor \
    git unzip libzip-dev \
    && docker-php-ext-install pcntl pdo_mysql zip \
    && rm -f /etc/nginx/sites-enabled/default \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer-bin /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/backend
COPY backend/ .

RUN composer install --no-interaction --prefer-dist --optimize-autoloader

COPY docker/prod/nginx.conf /etc/nginx/conf.d/default.conf
COPY docker/prod/supervisord.conf /etc/supervisord.conf

RUN chown -R www-data:www-data /var/www/backend/storage /var/www/backend/bootstrap/cache

EXPOSE 80 8080

ENTRYPOINT ["/bin/sh", "-c", "set -e; cd /var/www/backend && php artisan migrate --force && exec /usr/bin/supervisord -c /etc/supervisord.conf"]
