aws_region                   = "ap-northeast-1"
project_name                 = "janken-card"
lightsail_availability_zone  = "ap-northeast-1a"
lightsail_instance_bundle_id = "small_3_0"
lightsail_db_bundle_id       = "micro_2_0"

db_password = "change-me-long-random"

# Laravel（ローカルで `php artisan key:generate --show` の値）
app_key = "base64:CHANGE_ME_LONG_KEY"

# Reverb（backend/.env の REVERB_APP_* と一致。REVERB_APP_KEY は VITE_REVERB_APP_KEY と同じ）
reverb_app_id     = "236160"
reverb_app_key    = "change-me-reverb-app-key"
reverb_app_secret = "change-me-reverb-app-secret"
